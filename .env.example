# Simpro API Configuration
# Copy this file to .env and fill in your values

# Base URL of the Simpro API (change to live URL when real access is enabled)
# Host (simpro_client, tests, scripts/verify-simpro-mock.py run on the host):
SIMPRO_BASE_URL=http://localhost:8100/api/v1.0
# Inside the Compose network (code running in a container on the same network):
# SIMPRO_BASE_URL=http://simpro-mock:8000/api/v1.0

# OAuth2 token endpoint (same host / in-network choice as SIMPRO_BASE_URL)
SIMPRO_TOKEN_URL=http://localhost:8100/oauth2/token
# SIMPRO_TOKEN_URL=http://simpro-mock:8000/oauth2/token

# OAuth2 Client Credentials (required when SIMPRO_AUTH_MODE=client_credentials)
SIMPRO_CLIENT_ID=your-client-id-here
SIMPRO_CLIENT_SECRET=your-client-secret-here

# Auth mode: 'client_credentials' or 'api_key'. Any other value is rejected.
SIMPRO_AUTH_MODE=client_credentials

# Static API key (required when SIMPRO_AUTH_MODE=api_key, otherwise unused)
# SIMPRO_API_KEY=your-api-key-here

# Company IDs for CVC multi-company setup.
# Reserved: simpro_client does not read these. They record the mapping that
# the mock seeds; endpoint calls take an explicit company_id argument.
SIMPRO_COMPANY_ID_SERVICE=1
SIMPRO_COMPANY_ID_PROJECTS=2

# HTTP settings
SIMPRO_TIMEOUT=30.0
SIMPRO_MAX_RETRIES=3
SIMPRO_LIMITER_CAPACITY=8
SIMPRO_LIMITER_REFILL_RATE=8.0

# Phase 1/2 PGVector database (read by docker-compose.yml for postgres and open-webui)
POSTGRES_DB=your-db-name
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password

# Phase 3 mock database (read by docker-compose.yml for simpro-mock-db and simpro-mock).
# Use URL-safe characters only: docker-compose.yml builds SIMPRO_MOCK_DATABASE_URL from these.
SIMPRO_MOCK_DB_USER=your-mock-db-user
SIMPRO_MOCK_DB_PASSWORD=your-mock-db-password
SIMPRO_MOCK_DB_NAME=simpro_mock
